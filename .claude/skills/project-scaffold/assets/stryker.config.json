{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "dryRunTimeoutMinutes": 30,
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/*.test-d.{ts,tsx}",
    "!src/**/index.ts",
    "!src/**/types.ts",
    "!src/app/**",
    "!src/shared/stub.ts"
  ],
  "reporters": ["clear-text", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  }
}
