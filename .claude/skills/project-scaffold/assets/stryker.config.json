{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/index.ts",
    "!src/**/types.ts",
    "!src/app/**",
    "!src/shared/stub.ts"
  ],
  "reporters": ["clear-text", "html"],
  "htmlReporter": { "fileName": "reports/mutation.html" },
  "thresholds": { "high": 90, "low": 75, "break": 70 }
}
