{
  "name": "<project-name>",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "pnpm --filter @<project-name>/app start",
    "typecheck": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:slow": "vitest run --mode slow --passWithNoTests",
    "perf": "vitest run --mode perf --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage --mode full",
    "deps": "depcruise packages",
    "deps:graph": "depcruise packages --output-type dot | dot -T svg > reports/deps.svg",
    "deadcode": "knip",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm deps && pnpm deadcode",
    "mutation": "stryker run",
    "build": "echo 'nothing to build: node runs every package src/ directly' && exit 0",
    "e2e": "echo 'no e2e suite yet' && exit 0"
  }
}
